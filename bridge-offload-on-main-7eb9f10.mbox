From 9283b2f44b09d9771d37bc5fa297884c46474eb4 Mon Sep 17 00:00:00 2001
From: Bohdan Chubuk <chbgdn@gmail.com>
Date: Wed, 1 Jul 2026 08:24:50 +0300
Subject: [PATCH 07/12] firewall4: add bridge flowtable support

Generate a bridge-family flowtable (table bridge fw4, flowtable fb)
when the offload device list contains bridge ports. The bridge
flowtable is required for hardware offload of L2-forwarded traffic
via nft_flow_offload (bridge fastpath).

Uses /sys/class/net/<dev>/brport to detect bridge ports among
the configured flowtable devices.

Signed-off-by: Bohdan Chubuk <chbgdn@gmail.com>
---
 package/network/config/firewall4/Makefile     |  2 +-
 .../001-add-bridge-flowtable-support.patch    | 74 +++++++++++++++++++
 2 files changed, 75 insertions(+), 1 deletion(-)
 create mode 100644 package/network/config/firewall4/patches/001-add-bridge-flowtable-support.patch

diff --git a/package/network/config/firewall4/Makefile b/package/network/config/firewall4/Makefile
index ccd5b73c..a13b5fc3 100644
--- a/package/network/config/firewall4/Makefile
+++ b/package/network/config/firewall4/Makefile
@@ -5,7 +5,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=firewall4
-PKG_RELEASE:=1
+PKG_RELEASE:=2
 
 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL=$(PROJECT_GIT)/project/firewall4.git
diff --git a/package/network/config/firewall4/patches/001-add-bridge-flowtable-support.patch b/package/network/config/firewall4/patches/001-add-bridge-flowtable-support.patch
new file mode 100644
index 00000000..cf324e84
--- /dev/null
+++ b/package/network/config/firewall4/patches/001-add-bridge-flowtable-support.patch
@@ -0,0 +1,74 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Bohdan Chubuk <chbgdn@gmail.com>
+Date: Wed, 1 Jul 2026 08:24:50 +0300
+Subject: [PATCH] firewall4: add bridge flowtable support
+
+Generate a bridge-family flowtable (table bridge fw4, flowtable fb)
+when the offload device list contains bridge ports, so L2-forwarded
+traffic can be offloaded via nft_flow_offload.
+
+Signed-off-by: Bohdan Chubuk <chbgdn@gmail.com>
+---
+--- a/root/usr/share/ucode/fw4.uc	2026-07-01 09:54:35.812914268 +0300
++++ b/root/usr/share/ucode/fw4.uc	2026-07-01 09:54:55.802938364 +0300
+@@ -575,6 +575,26 @@
+ 		return false;
+ 	},
+ 
++	check_bridge_flowtable: function() {
++		for (let item in nft_json_command("list", "flowtables", "bridge"))
++			if (item.flowtable?.table == "fw4" && item.flowtable?.name == "fb")
++				return true;
++
++		return false;
++	},
++
++	resolve_bridge_devices: function(devices) {
++		let bridge_devs = [];
++
++		for (let dev in devices)
++			if (fs.access(`/sys/class/net/${dev}/brport`))
++				push(bridge_devs, dev);
++			else if (fs.access(`/sys/class/net/${dev}/bridge`))
++				push(bridge_devs, dev);
++
++		return bridge_devs;
++	},
++
+ 	read_state: function() {
+ 		let fd = fs.open(STATEFILE, "r");
+ 		let state = null;
+--- a/root/usr/share/firewall4/templates/ruleset.uc	2026-07-01 09:54:35.813882416 +0300
++++ b/root/usr/share/firewall4/templates/ruleset.uc	2026-07-01 09:55:01.833025066 +0300
+@@ -469,4 +469,31 @@
+ 	}
+ {% fw4.includes('table-append') %}
+ }
++table bridge fw4
++flush table bridge fw4
++{% if (fw4.check_bridge_flowtable()): %}
++delete flowtable bridge fw4 fb
++{% endif %}
++
++{% let bridge_devices = fw4.resolve_bridge_devices(flowtable_devices); %}
++{% if (length(bridge_devices) > 0): %}
++table bridge fw4 {
++	#
++	# Bridge flowtable
++	#
++	flowtable fb {
++		hook ingress priority 0;
++		devices = {{ fw4.set(bridge_devices, true) }};
++		counter;
++{% if (fw4.default_option("flow_offloading_hw")): %}
++		flags offload;
++{% endif %}
++	}
++
++	chain forward {
++		type filter hook forward priority filter; policy accept;
++		meta l4proto { tcp, udp } flow offload @fb;
++	}
++}
++{% endif %}
+ {% fw4.includes('ruleset-append') %}

