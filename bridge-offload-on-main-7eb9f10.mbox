From 9760d8cb0e13abe1715fa162b1ba06a06cb26f83 Mon Sep 17 00:00:00 2001
From: Bohdan Chubuk <chbgdn@gmail.com>
Date: Wed, 1 Jul 2026 06:02:15 +0300
Subject: [PATCH 01/12] kernel: add kmod-nf-conntrack-bridge package

Add package definition for bridge connection tracking module
(CONFIG_NF_CONNTRACK_BRIDGE), which provides native bridge
conntrack as a replacement for br_netfilter.

Required for nft_flow_offload bridge fastpath support.

Signed-off-by: Bohdan Chubuk <chbgdn@gmail.com>
---
 package/kernel/linux/modules/netfilter.mk | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/package/kernel/linux/modules/netfilter.mk b/package/kernel/linux/modules/netfilter.mk
index debc2a5a..9c9c4161 100644
--- a/package/kernel/linux/modules/netfilter.mk
+++ b/package/kernel/linux/modules/netfilter.mk
@@ -1229,6 +1229,23 @@ endef
 $(eval $(call KernelPackage,nfnetlink-cttimeout))
 
 
+define KernelPackage/nf-conntrack-bridge
+  SUBMENU:=$(NF_MENU)
+  TITLE:=IPv4/IPv6 bridge connection tracking support
+  DEPENDS:=+kmod-nf-conntrack
+  FILES:=$(LINUX_DIR)/net/bridge/netfilter/nf_conntrack_bridge.ko
+  KCONFIG:=CONFIG_NF_CONNTRACK_BRIDGE
+  AUTOLOAD:=$(call AutoProbe,nf_conntrack_bridge)
+endef
+
+define KernelPackage/nf-conntrack-bridge/description
+ Native bridge connection tracking, replacement for br_netfilter.
+ Required for nft_flow_offload bridge offload (bridge fastpath).
+endef
+
+$(eval $(call KernelPackage,nf-conntrack-bridge))
+
+
 define KernelPackage/nf-conntrack-netlink
   TITLE:=Connection tracking netlink interface
   FILES:=$(LINUX_DIR)/net/netfilter/nf_conntrack_netlink.ko

From 8aa94aa8efe1e29c617cfee5983de3b53ff8a068 Mon Sep 17 00:00:00 2001
From: Bohdan Chubuk <chbgdn@gmail.com>
Date: Wed, 1 Jul 2026 05:22:59 +0300
Subject: [PATCH 02/12] generic: pending-6.18: add nft_flow_offload bridge
 offload

Backport Eric Woudstra bridge fastpath series adding nftables bridge
family flowtable support for hardware offload of L2-forwarded traffic.

Patches are based on commits from ericwoud/bpir-nftflow-nf-next-20260707.

The series adds (675-01 through 675-12):
- 675-01: nf_ip(6)_checksum(_partial) fix for data != network header
- 675-02: bridge conntrack with double-VLAN and PPPoE encapsulation
  tracking
- 675-03: DEV_PATH_MTK_WDMA handling in nft_dev_path_info()
- 675-04: DEV_PATH_BR_VLAN_KEEP_HW VLAN mode for switchdev offload
- 675-05: port-to-port bridge forward path resolution
- 675-06: dev_fill_bridge_path() for forward path walks from bridge
  ports
- 675-07: nf_flow_rule_bridge() for bridge hardware offload rules
- 675-08: nf_flowtable_type flowtable_bridge
- 675-09: nft_flow_offload_eval() thoff == 0 check
- 675-10: NFPROTO_BRIDGE support in nft_flow_offload_validate()
- 675-11: flow_offload_bridge_init() for bridge flow tuple setup
- 675-12: bridge_fastpath.sh netfilter selftest

The kmod-nf-conntrack-bridge package added alongside this series
selects CONFIG_NF_CONNTRACK_BRIDGE via its KCONFIG entry, so no
generic config change is needed.

Co-authored-by: Eric Woudstra <ericwouds@gmail.com>
Signed-off-by: Bohdan Chubuk <chbgdn@gmail.com>
